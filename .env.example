# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in
# PGLITE_DIR — zero setup, ideal for running on your own machine/server.
# For hosted deployments use any PostgreSQL 14+ (Supabase, Neon, RDS, …):
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Set to true to apply migrations automatically on startup when using DATABASE_URL
# (otherwise run `npm run db:migrate` during deploy).
AUTO_MIGRATE=false
# Transaction-mode poolers (Supabase pooler, PgBouncer) need prepared statements off (default).
DATABASE_PREPARE=false
DATABASE_POOL_SIZE=5

# ── Authentication (required in production) ────────────────────────────────
# Single-user password login. In development, leaving APP_PASSWORD empty runs
# the app without login. In production the app refuses to serve without both.
APP_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ── AI (Claude) ─────────────────────────────────────────────────────────────
# Enables text/photo meal analysis and the nutrition assistant.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
# Server-side refusal fallback is on by default; set to "off" if your API
# gateway rejects the `fallbacks` parameter.
ANTHROPIC_FALLBACKS=

# ── Nutrition database (USDA FoodData Central) ─────────────────────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup  (without it the shared,
# heavily rate-limited DEMO_KEY is used for online lookups). Run
# `npm run usda:import` once to store ~13,000 foods locally.
FDC_API_KEY=

# ── Meal photo storage ─────────────────────────────────────────────────────
# "db" (default) stores resized photos in PostgreSQL. "s3" uses any
# S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage S3, MinIO).
IMAGE_STORAGE=db
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
